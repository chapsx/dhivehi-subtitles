<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DhivehiSubtitles" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#B2DFDB</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="actionBarStyle">@style/DS.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="DS.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/brand</item>
        <item name="titleTextStyle">@style/DS.ActionBar.Title</item>
    </style>

    <style name="DS.ActionBar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="DS.ToolButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DS.HomeButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="iconPadding">14dp</item>
    </style>

    <style name="DS.HomeButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
</resources>
